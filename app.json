{
  "expo": {
    "name": "StepLeague",
    "slug": "step-league",
    "scheme": "stepleague",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.andrejtesten.stepleague",
      "infoPlist": {
        "NSHealthShareUsageDescription": "StepLeague reads your daily step count so it can update your standing in your leagues.",
        "NSHealthUpdateUsageDescription": "StepLeague does not write any health data. This permission is required by Apple even for read-only access.",
        "NSPhotoLibraryUsageDescription": "StepLeague needs access to your photos so you can set a profile picture.",
        "NSMotionUsageDescription": "StepLeague reads your step count in real time so today's total updates live while the app is open."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "package": "com.andrejtesten.stepleague",
      "adaptiveIcon": {
        "backgroundColor": "#ccff33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "StepLeague reads your daily step count to update your league standing.",
          "healthUpdatePermission": "StepLeague does not write health data."
        }
      ],
      [
        "react-native-health-connect",
        {
          "permissions": [
            "android.permission.health.READ_STEPS"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#0b0c0a",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0b0c0a"
          }
        }
      ],
      "@sentry/react-native",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Step League can save a league's final results card to your photos.",
          "savePhotosPermission": "Step League can save a league's final results card to your photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "47c408a2-8abc-4cd3-ba09-dfee556ae78f"
      }
    },
    "owner": "rej33"
  }
}
