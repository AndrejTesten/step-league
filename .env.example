# Copy this file to .env and fill in your own Supabase project's values
# (Project Settings -> API in the Supabase dashboard).
#
# The EXPO_PUBLIC_ prefix means Expo inlines these into the JS bundle at
# build time — that's expected and safe for the anon key (see lib/supabase.ts
# for why row-level security, not key secrecy, is what protects your data).
# Never put the service_role key here — that one only belongs in the Edge
# Function's server-side secrets (`supabase secrets set`).

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
